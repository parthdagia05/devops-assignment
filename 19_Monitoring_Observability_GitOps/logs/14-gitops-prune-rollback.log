$ # 4. prune: remove the PodDisruptionBudget from Git -> Argo CD deletes it from the cluster

$ kubectl get pdb -n gitops-prod
NAME      MIN AVAILABLE   MAX UNAVAILABLE   ALLOWED DISRUPTIONS   AGE
podinfo   1               N/A               2                     2m53s

$ git rm -q podinfo/overlays/prod/pdb.yaml && sed -i '' 's/resources: \[..\/..\/base, pdb.yaml\]/resources: [..\/..\/base]/' podinfo/overlays/prod/kustomization.yaml && git diff --cached --stat; git diff podinfo/overlays/prod/kustomization.yaml
 podinfo/overlays/prod/pdb.yaml | 7 -------
 1 file changed, 7 deletions(-)
diff --git a/podinfo/overlays/prod/kustomization.yaml b/podinfo/overlays/prod/kustomization.yaml
index 90baa73..6f82a67 100644
--- a/podinfo/overlays/prod/kustomization.yaml
+++ b/podinfo/overlays/prod/kustomization.yaml
@@ -1,6 +1,6 @@
 apiVersion: kustomize.config.k8s.io/v1beta1
 kind: Kustomization
-resources: [../../base, pdb.yaml]
+resources: [../../base]
 labels:
   - pairs: { env: prod }
 images:

$ git commit -qam 'prod: drop the PodDisruptionBudget' && git push 2>&1 | grep -E 'main'
