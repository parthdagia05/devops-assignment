time="2026-10-07T00:01:05Z" level=info msg="Adding resource result, status: 'Pruned', phase: 'Succeeded', message: 'pruned'" app-namespace=argocd application=podinfo-prod kind=PodDisruptionBudget name=podinfo namespace=gitops-prod

