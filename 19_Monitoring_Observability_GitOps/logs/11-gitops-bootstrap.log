$ kubectl get ns gitops-dev gitops-prod   # nothing deployed yet
Error from server (NotFound): namespaces "gitops-dev" not found
Error from server (NotFound): namespaces "gitops-prod" not found

$ kubectl get applications -n argocd
No resources found in argocd namespace.

$ # bootstrap: the ONLY manual kubectl apply in the whole GitOps flow

$ kubectl apply -f 03-gitops/bootstrap/root-app.yaml
application.argoproj.io/root created

$ # ~50s later: root synced apps/ from Git, which created two more Applications, which synced their overlays

$ kubectl get applications -n argocd
NAME           SYNC STATUS   HEALTH STATUS
podinfo-dev    Synced        Healthy
podinfo-prod   Synced        Healthy
root           Synced        Healthy

$ argocd app list
NAME                 CLUSTER                         NAMESPACE    PROJECT  STATUS  HEALTH   SYNCPOLICY  CONDITIONS  REPO                                               PATH                   TARGET
argocd/podinfo-dev   https://kubernetes.default.svc  gitops-dev   default  Synced  Healthy  Auto-Prune  <none>      http://gitea.gitea.svc:3000/parth/gitops-demo.git  podinfo/overlays/dev   main
argocd/podinfo-prod  https://kubernetes.default.svc  gitops-prod  default  Synced  Healthy  Auto-Prune  <none>      http://gitea.gitea.svc:3000/parth/gitops-demo.git  podinfo/overlays/prod  main
argocd/root          https://kubernetes.default.svc  argocd       default  Synced  Healthy  Auto-Prune  <none>      http://gitea.gitea.svc:3000/parth/gitops-demo.git  apps                   main

